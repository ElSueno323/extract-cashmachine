# Adresse d'écoute de l'application web
LISTEN_ADDR=127.0.0.1:8080

# Délai maximum pour joindre une caisse, en secondes
HTTP_TIMEOUT_SECONDS=20

# Chemin du fichier de transactions sur chaque caisse
CSV_PATH=/ShopMasterTransactions2.csv

# Une ligne par caisse : identifiant|Nom affiché|adresse
# L'identifiant est en minuscules, chiffres et tirets uniquement.
SITE_1=exemple|Nom du site|0.0.0.0
